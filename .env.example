# ── Store Targeting ──────────────────────────────────────
TARGET_STORE=dev
PRODUCTION_WRITES_ENABLED=false

# ── BigCommerce Dev Store ───────────────────────────────
BC_DEV_STORE_HASH=
BC_DEV_ACCESS_TOKEN=
BC_DEV_CLIENT_ID=
BC_DEV_CLIENT_SECRET=

# ── BigCommerce Prod Store ──────────────────────────────
BC_PROD_STORE_HASH=
BC_PROD_ACCESS_TOKEN=
BC_PROD_CLIENT_ID=
BC_PROD_CLIENT_SECRET=

# ── Database (Neon Postgres) ────────────────────────────
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# ── Encryption (32-byte hex key for AES-256-GCM) ───────
ENCRYPTION_KEY=

# ── Cloudflare R2 ──────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tpp-wholesale-docs
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# ── Resend ─────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=no-reply@wholesale.theperfectpart.net

# ── ClamAV (Railway) ──────────────────────────────────
CLAMAV_HOST=
CLAMAV_PORT=3310

# ── Auth ───────────────────────────────────────────────
JWT_SECRET=
ADMIN_ALLOWLIST=adam@theperfectpart.net

# ── Cron ───────────────────────────────────────────────
CRON_SECRET=

# ── App URL ────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001
