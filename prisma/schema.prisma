generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Portal user (magic-link auth) ──────────────────────
model PortalUser {
  id                String   @id @default(cuid())
  email             String   @unique
  linkedCustomerId  Int?     @map("linked_customer_id")
  avatarKey         String?  @map("avatar_key")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  wholesaleAccount  WholesaleAccount?
  sessions          Session[]
  teamMemberships   TeamMember[]

  @@map("portal_users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ── Wholesale account (application + status) ───────────
enum AccountStatus {
  RETAIL
  PENDING
  APPROVED
  DENIED
}

model WholesaleAccount {
  id              String        @id @default(cuid())
  userId          String        @unique @map("user_id")
  customerId      Int?          @map("customer_id")
  email           String
  companyName     String        @map("company_name")
  alias           String        // sanitized, stable, admin-editable
  legalName       String?       @map("legal_name")
  businessAddress String?       @map("business_address")
  phone           String?
  website         String?
  primaryState    String?       @map("primary_state")
  attestation     Boolean       @default(false)
  status          AccountStatus @default(RETAIL)
  denialReason    String?       @map("denial_reason")
  approvedAt      DateTime?     @map("approved_at")
  lastTier        String        @default("NONE") @map("last_tier") // NONE, T10, T15, T20
  lastCount7d     Int           @default(0) @map("last_count_7d")
  pausedUpgrades    Boolean       @default(false) @map("paused_upgrades")
  welcomeExpiresAt  DateTime?     @map("welcome_expires_at") // welcome discount expiry
  businessFields    Json?         @map("business_fields")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  onboardingDismissed Boolean  @default(false) @map("onboarding_dismissed")
  onboardingFlags    Json?    @map("onboarding_flags") // e.g. { browsedHotSellers: true }

  user              PortalUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents         Document[]
  promotions        PromotionRecord[]
  snapshots         TierSnapshot[]
  riskFlags         RiskFlag[]
  infoChangeRequests BusinessInfoChange[]
  teamMembers       TeamMember[]

  @@index([status])
  @@index([email])
  @@index([customerId])
  @@index([lastCount7d])
  @@map("wholesale_accounts")
}

// ── Document uploads ───────────────────────────────────
enum ScanStatus {
  PENDING
  SCANNING
  CLEAN
  INFECTED
}

model Document {
  id          String     @id @default(cuid())
  accountId   String     @map("account_id")
  filename    String
  mime        String
  size        Int
  storageKey  String     @map("storage_key")
  scanStatus  ScanStatus @default(PENDING) @map("scan_status")
  state       String?    // US state, optional
  docType     String?    @map("doc_type") // resale_cert, business_license, etc.
  permitId    String?    @map("permit_id")
  note        String?
  uploadedAt  DateTime   @default(now()) @map("uploaded_at")

  account WholesaleAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([scanStatus, uploadedAt])
  @@map("documents")
}

// ── Promotion tracking ─────────────────────────────────
model PromotionRecord {
  id         String    @id @default(cuid())
  accountId  String    @map("account_id")
  tier       String    // T10, T15, T20
  promoId    Int?      @map("promo_id") // BigCommerce promotion ID
  code       String
  enabled    Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at")
  disabledAt DateTime? @map("disabled_at")

  account WholesaleAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, tier])
  @@map("promotion_records")
}

// ── Tier snapshots (history) ───────────────────────────
model TierSnapshot {
  id           String   @id @default(cuid())
  accountId    String   @map("account_id")
  asOf         DateTime @map("as_of")
  paidOrders7d Int      @map("paid_orders_7d")
  tierLevel    String   @map("tier_level") // NONE, T10, T15, T20
  activeCode   String?  @map("active_code")
  createdAt    DateTime @default(now()) @map("created_at")

  account WholesaleAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, asOf])
  @@map("tier_snapshots")
}

// ── Risk flags ─────────────────────────────────────────
enum FlagStatus {
  OPEN
  CLEARED
  KEPT
}

model RiskFlag {
  id         String     @id @default(cuid())
  accountId  String     @map("account_id")
  type       String     // rapid_low_value, same_sku_farming, tier_chasing
  details    Json
  status     FlagStatus @default(OPEN)
  clearedAt  DateTime?  @map("cleared_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  account WholesaleAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([accountId])
  @@map("risk_flags")
}

// ── Webhook event log ──────────────────────────────────
enum EventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

model WebhookEvent {
  id          String      @id @default(cuid())
  type        String
  payload     Json
  receivedAt  DateTime    @default(now()) @map("received_at")
  processedAt DateTime?   @map("processed_at")
  status      EventStatus @default(RECEIVED)
  error       String?

  @@index([status, receivedAt])
  @@map("webhook_events")
}

// ── Business info change requests ────────────────────────
enum ChangeRequestStatus {
  PENDING
  APPROVED
  DENIED
}

model BusinessInfoChange {
  id          String              @id @default(cuid())
  accountId   String              @map("account_id")
  oldValues   Json                @map("old_values")
  newValues   Json                @map("new_values")
  status      ChangeRequestStatus @default(PENDING)
  reviewNote  String?             @map("review_note")
  reviewedBy  String?             @map("reviewed_by") // admin email
  reviewedAt  DateTime?           @map("reviewed_at")
  createdAt   DateTime            @default(now()) @map("created_at")

  account WholesaleAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, status])
  @@map("business_info_changes")
}

// ── Audit log ──────────────────────────────────────────
model AuditLog {
  id               String   @id @default(cuid())
  actorEmail       String   @map("actor_email")
  action           String
  targetCustomerId Int?     @map("target_customer_id")
  targetAccountId  String?  @map("target_account_id")
  details          Json?
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_logs")
}

// ── Announcements ──────────────────────────────────────
model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  priority    String    @default("normal") // normal, important, urgent
  published   Boolean   @default(false)
  publishedAt DateTime? @map("published_at")
  expiresAt   DateTime? @map("expires_at")
  authorEmail String    @map("author_email")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("announcements")
}

// ── Team members (multi-user accounts) ─────────────────
enum TeamRole {
  OWNER
  ADMIN
  PURCHASER
  VIEWER
}

model TeamMember {
  id         String    @id @default(cuid())
  accountId  String    @map("account_id")
  userId     String    @map("user_id")
  role       TeamRole  @default(VIEWER)
  invitedBy  String    @map("invited_by") // email of inviter
  invitedAt  DateTime  @default(now()) @map("invited_at")
  acceptedAt DateTime? @map("accepted_at")

  account WholesaleAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    PortalUser       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, userId])
  @@map("team_members")
}

// ── Global settings (admin-editable) ───────────────────
model GlobalSettings {
  id        String   @id @default("global")
  settings  Json     // tier thresholds, risk rules, shipping label, etc.
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("global_settings")
}
